generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}


enum OAuthProvider {
  GOOGLE
  GITHUB

  @@schema("auth")
}

enum Role {
  OWNER
  ADMIN
  USER
  PROVIDER

  @@schema("auth")
}



model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  phone           String?
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  credentials   UserCredential?
  oauthAccounts OAuthAccount[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  otps          OTP[]
  auditLogs     AuditLogs[]
  memberships   Membership[]

  @@schema("auth")
}

model UserCredential {
  id                 String   @id @default(uuid())
  userId             String   @unique
  passwordHash       String
  lastPasswordChange DateTime @default(now())
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("auth")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  revoked    Boolean  @default(false)
  replacedBy String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken?  @relation("TokenReplacement", fields: [replacedBy], references: [id])
  replacements    RefreshToken[] @relation("TokenReplacement")

  @@index([userId])
  @@index([tokenHash])
  @@schema("auth")
}

model OTP {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  type      String
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
  @@schema("auth")
}

model AuditLogs {
  id        String   @id @default(uuid())
  userId    String?
  eventType String
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  memberships Membership[]

  @@schema("auth")
}

model Membership {
  id     String @id @default(uuid())
  userId String
  orgId  String
  role   Role

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@schema("auth")
}
